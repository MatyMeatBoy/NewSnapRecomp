+                    if (c < 3 && value) empty = 0, lit[image * tiles + (size_t)(y / 16) * tw + x / 16] = 1;
+                    if (!image && in[(size_t)x * 4 + c] != copy[(size_t)y * copy_pitch + (size_t)x * 4 + c]) mismatch++;
+                }
+            }
+            black[image] += empty;
+        }
+        if (!files) continue;
